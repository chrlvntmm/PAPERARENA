NODE_ENV=development
PORT=3001

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/paperarena
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_CHALLENGE_MAX=20
RATE_LIMIT_AUTH_VERIFY_MAX=20
RATE_LIMIT_WS_CONNECT_MAX=60

AUTH_APP_NAME=PaperArena
AUTH_COOKIE_NAME=pa_session
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
AUTH_EXPECTED_DOMAIN=localhost
AUTH_EXPECTED_URI=http://127.0.0.1:8080
AUTH_SESSION_TTL_SECONDS=604800
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

SOLANA_AUTH_BYPASS=false
ESCROW_BYPASS=false
AUTH_DEV_BYPASS=false

LOGIC_TICK_MS=50
BROADCAST_HZ=20
PRE_MATCH_COUNTDOWN_MS=5000
DISCONNECT_GRACE_MS=3000
PLATFORM_FEE=0.02
STANDARD_ARENA_PLAYERS=5
STANDARD_ARENA_DURATION_MS=150000
STANDARD_ARENA_COLS=64
MEGA_ARENA_PLAYERS=10
MEGA_ARENA_DURATION_MS=300000
MEGA_ARENA_COLS=96
WAGER_TIERS=5,10,20
