NODE_ENV=development
PORT=3001

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/paperarena
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_CHALLENGE_MAX=20
RATE_LIMIT_AUTH_VERIFY_MAX=20
RATE_LIMIT_WS_CONNECT_MAX=60

AUTH_APP_NAME=PaperArena
AUTH_COOKIE_NAME=pa_session
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
AUTH_EXPECTED_DOMAIN=localhost
AUTH_EXPECTED_URI=http://127.0.0.1:8080
AUTH_SESSION_TTL_SECONDS=604800
AUTH_CHALLENGE_TTL_SECONDS=300
DEPOSIT_INTENT_TTL_SECONDS=900
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SOLANA_CLUSTER=devnet
SOLANA_DEVNET_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_KEY
SOLANA_MAINNET_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY

SOLANA_AUTH_BYPASS=false
ESCROW_BYPASS=false
AUTH_DEV_BYPASS=false

# Devnet PaperArena escrow program (set ESCROW_BYPASS=false to use real funds)
ESCROW_PROGRAM_ID=EQyF5gzy1hzY38fiQhtW3CHLNYaAt3oknb39ceigZtNM
ESCROW_TOKEN_MINT=4LUhzrjpWJurTWRKGE3WKKtYV267e5qNvuBoKSBqBwUd
ESCROW_TREASURY_TOKEN_ACCOUNT=C82i2y5aji1cp1cCg5V7DqFhy7d3uSZJuFixC99K2Kt3
ESCROW_TOKEN_SYMBOL=USDC
ESCROW_TOKEN_DECIMALS=6
# game_authority signer for lock_match / settle_match (never commit real secrets)
# Pubkey must match on-chain config (devnet: 7Y8wr37JTtV7PPWsdYHTZaFeuT7kJXTAJb6AP4HfEvye)
# ESCROW_GAME_AUTHORITY_SECRET=[1,2,3,...]
# ESCROW_GAME_AUTHORITY_KEYPAIR_PATH=C:\path\to\game-authority.json

# Ops recovery API (required in production). Header: x-ops-secret
OPS_SECRET=replace-with-long-random-ops-secret
# Wait for in-flight settlements on SIGTERM (ms) — production only
SHUTDOWN_DRAIN_MS=15000
# Log noise: debug | info | warn | error  (default: warn in dev, info in prod)
LOG_LEVEL=warn

LOGIC_TICK_MS=50
MOVEMENT_TICKS_PER_STEP=2
BROADCAST_HZ=20
PRE_MATCH_COUNTDOWN_MS=5000
DISCONNECT_GRACE_MS=3000
PLATFORM_FEE=0.02
STANDARD_ARENA_PLAYERS=5
STANDARD_ARENA_DURATION_MS=150000
STANDARD_ARENA_COLS=64
MEGA_ARENA_PLAYERS=10
MEGA_ARENA_DURATION_MS=300000
MEGA_ARENA_COLS=96
WAGER_TIERS=5,10,20
